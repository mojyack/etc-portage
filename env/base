COMMON_FLAGS="-O2 $COPTFLAGS"
CFLAGS="$COMMON_FLAGS -pipe"
CXXFLAGS="$COMMON_FLAGS -pipe"
FCFLAGS="$COMMON_FLAGS"
FFLAGS="$COMMON_FLAGS"
RUSTFLAGS="-C opt-level=3 $RUSTOPTFLAGS"

LDFLAGS="-Wl,--as-needed -Wl,--undefined-version"

LINGUAS="en"
L10N="en"
INSTALL_MASK="
	/usr/share/man
	/usr/share/doc
	/usr/share/gtk-doc
	/usr/share/info
	/usr/lib/*/share/man
	/usr/lib/*/share/doc
	/usr/lib/rust/*/share/man
	/usr/lib/rust/*/share/doc
"

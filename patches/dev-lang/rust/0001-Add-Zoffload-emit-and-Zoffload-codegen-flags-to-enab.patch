@@ -0,0 +1,164 @@
+//! Backend offload, emit side (Option A).
+//!
+//! When `-Zoffload-emit=<dir>` is given, the frontend runs normally and each codegen
+//! unit is lowered to *unoptimized* LLVM bitcode, which is written into `<dir>` together
+//! with a manifest describing everything the backend needs to resume optimization and
+//! machine-code generation on another machine (Option B, `-Zoffload-codegen=<manifest>`).
+//!
+//! The cut point is the boundary of `WorkItem::Optimize`: modules arrive fully codegened
+//! but unoptimized, exactly the state that serializes cleanly to bitcode. See
+//! `execute_optimize_work_item` in `back/write.rs`.
+
+use std::fmt::Write as _;
+use std::path::{Path, PathBuf};
+
+use rustc_session::Session;
+use rustc_session::config::{OutFileName, OutputFilenames, OutputType};
+
+use crate::ModuleKind;
+
+/// One codegen unit whose unoptimized bitcode has been written out for offload.
+pub struct OffloadCgu {
+    pub name: String,
+    pub kind: ModuleKind,
+    /// Path of the written bitcode file (inside the offload directory).
+    pub bitcode: PathBuf,
+}
+
+fn module_kind_str(kind: ModuleKind) -> &'static str {
+    match kind {
+        ModuleKind::Regular => "regular",
+        ModuleKind::Allocator => "allocator",
+    }
+}
+
+/// Minimal JSON string escaping (enough for paths and identifiers on the targets we care
+/// about). Avoids pulling a serialization dependency into this crate for the manifest.
+fn json_escape(s: &str) -> String {
+    let mut out = String::with_capacity(s.len() + 2);
+    for c in s.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if (c as u32) < 0x20 => {
+                let _ = write!(out, "\\u{:04x}", c as u32);
+            }
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+fn path_str(p: &Path) -> String {
+    json_escape(&p.to_string_lossy())
+}
+
+fn out_file_path(out: &OutFileName) -> Option<PathBuf> {
+    match out {
+        OutFileName::Real(p) => Some(p.clone()),
+        OutFileName::Stdout => None,
+    }
+}
+
+/// Write the offload manifest (`manifest.json`) into `dir`.
+///
+/// The manifest records the target description and codegen flags that the resuming
+/// backend must reproduce, plus the list of bitcode files. It is intentionally a plain,
+/// versioned, self-describing format so the Option B side stays decoupled from rustc's
+/// internal option representation.
+pub fn write_manifest(
+    sess: &Session,
+    outputs: &OutputFilenames,
+    cgus: &[OffloadCgu],
+    dir: &Path,
+) {
+    let opts = &sess.opts;
+
+    let mut j = String::new();
+    j.push_str("{\n");
+    let _ = writeln!(j, "  \"manifest_version\": 1,");
+
+    // What rustc produced this, so Option B can refuse on a version/LLVM mismatch.
+    let _ = writeln!(j, "  \"rustc_version\": \"{}\",", json_escape(sess.cfg_version));
+
+    // Target description.
+    let _ = writeln!(j, "  \"target\": \"{}\",", json_escape(opts.target_triple.tuple()));
+    let _ = writeln!(j, "  \"llvm_target\": \"{}\",", json_escape(&sess.target.llvm_target));
+    match &opts.cg.target_cpu {
+        Some(cpu) => {
+            let _ = writeln!(j, "  \"target_cpu\": \"{}\",", json_escape(cpu));
+        }
+        None => {
+            let _ = writeln!(j, "  \"target_cpu\": null,");
+        }
+    }
+    let _ =
+        writeln!(j, "  \"target_feature\": \"{}\",", json_escape(&opts.cg.target_feature));
+
+    // Codegen flags that influence optimization and machine-code generation.
+    let _ = writeln!(j, "  \"opt_level\": \"{:?}\",", opts.optimize);
+    let _ = writeln!(j, "  \"relocation_model\": \"{:?}\",", sess.relocation_model());
+    match sess.code_model() {
+        Some(cm) => {
+            let _ = writeln!(j, "  \"code_model\": \"{cm:?}\",");
+        }
+        None => {
+            let _ = writeln!(j, "  \"code_model\": null,");
+        }
+    }
+    let _ = writeln!(j, "  \"debuginfo\": \"{:?}\",", opts.debuginfo);
+
+    // Crate types and the artifact location Option B is expected to fill in.
+    let crate_types: Vec<String> =
+        opts.crate_types.iter().map(|ct| format!("\"{ct:?}\"")).collect();
+    let _ = writeln!(j, "  \"crate_types\": [{}],", crate_types.join(", "));
+
+    let _ = writeln!(j, "  \"out_directory\": \"{}\",", path_str(&outputs.with_extension("")));
+    if let Some(rmeta) = out_file_path(&outputs.path(OutputType::Metadata)) {
+        let _ = writeln!(j, "  \"rmeta\": \"{}\",", path_str(&rmeta));
+    } else {
+        let _ = writeln!(j, "  \"rmeta\": null,");
+    }
+
+    // The codegen units, in deterministic order.
+    j.push_str("  \"cgus\": [\n");
+    for (i, cgu) in cgus.iter().enumerate() {
+        let comma = if i + 1 == cgus.len() { "" } else { "," };
+        let _ = writeln!(
+            j,
+            "    {{ \"name\": \"{}\", \"kind\": \"{}\", \"bitcode\": \"{}\" }}{comma}",
+            json_escape(&cgu.name),
+            module_kind_str(cgu.kind),
+            path_str(&cgu.bitcode),
+        );
+    }
+    j.push_str("  ]\n");
+    j.push_str("}\n");
+
+    let path = dir.join("manifest.json");
+    if let Err(err) = std::fs::write(&path, j) {
+        sess.dcx().fatal(format!("failed to write offload manifest `{}`: {err}", path.display()));
+    }
+
+    // Also write the CGU list in a trivially-parseable TSV (`kind\tname\tbitcode`) so the
+    // resuming `-Zoffload-codegen` step does not have to parse JSON. `manifest.json` above
+    // stays as the human-readable record.
+    let mut tsv = String::new();
+    for cgu in cgus {
+        let _ = writeln!(
+            tsv,
+            "{}\t{}\t{}",
+            module_kind_str(cgu.kind),
+            cgu.name,
+            cgu.bitcode.display()
+        );
+    }
+    let tsv_path = dir.join("offload.cgus");
+    if let Err(err) = std::fs::write(&tsv_path, tsv) {
+        sess.dcx()
+            .fatal(format!("failed to write offload CGU list `{}`: {err}", tsv_path.display()));
+    }
+}

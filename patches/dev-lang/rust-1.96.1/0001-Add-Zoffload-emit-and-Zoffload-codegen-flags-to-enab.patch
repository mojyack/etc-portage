+//! Backend offload, resume side: `-Zoffload-codegen=<dir>`.
+//!
+//! Picks up what an earlier `-Zoffload-emit=<dir>` run left behind — one unoptimized
+//! bitcode file per codegen unit plus an `offload.rlink` holding the module list, crate
+//! info, metadata and output filenames — and runs the LLVM optimization + machine-code
+//! pipeline on it, without a frontend.
+//!
+//! This is invoked with the *same* target and codegen flags as the emit step, so the
+//! `Session` alone carries everything needed to rebuild an equivalent `CodegenContext` and
+//! `ModuleConfig`.
+
+use std::ffi::CString;
+use std::path::Path;
+use std::sync::Arc;
+
+use rustc_abi::Size;
+use rustc_codegen_ssa::back::link;
+use rustc_codegen_ssa::back::lto::SerializedModule;
+use rustc_codegen_ssa::back::write::{
+    CodegenContext, ComputedLtoType, ModuleConfig, SharedEmitter, TargetMachineFactoryFn,
+    ThinLtoInput, compute_per_cgu_lto_type, do_thin_lto,
+};
+use rustc_codegen_ssa::traits::{CodegenBackend, ExtraBackendMethods, WriteBackendMethods};
+use rustc_codegen_ssa::{
+    CodegenError, CompiledModule, CompiledModules, CrateInfo, ModuleCodegen, ModuleKind,
+};
+use rustc_session::Session;
+use rustc_session::config::{CrateType, Lto, OutputFilenames};
+
+use crate::back::lto::ModuleBuffer;
+use crate::{LlvmCodegenBackend, ModuleLlvm, back, llvm_util};
+
+/// Build a `CodegenContext` equivalent to the one the normal pipeline builds, but from the
+/// `Session` alone (no `TyCtxt`). See the module docs for why this is sound.
+//
+// `bad_opt_access`: the lint steers towards `TyCtxt::crate_types`, but the whole point of
+// this path is that there is no `TyCtxt`; the command line's `--crate-type` (mirrored from
+// the emit step) is the source of truth here.
+#[allow(rustc::bad_opt_access)]
+fn build_codegen_context(
+    backend: &LlvmCodegenBackend,
+    sess: &Session,
+    outputs: Arc<OutputFilenames>,
+) -> CodegenContext {
+    let crate_types = sess.opts.crate_types.clone();
+    let module_config = Arc::new(ModuleConfig::new(ModuleKind::Regular, sess, &crate_types, false));
+
+    CodegenContext {
+        lto: sess.lto(),
+        use_linker_plugin_lto: sess.opts.cg.linker_plugin_lto.enabled(),
+        dylib_lto: sess.opts.unstable_opts.dylib_lto,
+        prefer_dynamic: sess.opts.cg.prefer_dynamic,
+        save_temps: sess.opts.cg.save_temps,
+        fewer_names: sess.fewer_names(),
+        time_trace: sess.opts.unstable_opts.llvm_time_trace,
+        msvc_imps_needed: sess.target.is_like_windows
+            && (sess.lto() == Lto::Thin || crate_types.contains(&CrateType::Rlib)),
+        crate_types,
+        output_filenames: outputs,
+        invocation_temp: sess.invocation_temp.clone(),
+        module_config,
+        // `-Zoffload-codegen` only targets the common (non-size) optimization levels for
+        // now; `backend_optimization_level` reduces to `sess.opts.optimize` there (the size
+        // levels additionally consult per-item `#[optimize]` attrs, which need a frontend).
+        opt_level: sess.opts.optimize,
+        backend_features: llvm_util::global_llvm_features(sess, false),
+        is_pe_coff: sess.target.is_like_windows,
+        target_can_use_split_dwarf: sess.target_can_use_split_dwarf(),
+        target_arch: sess.target.arch.to_string(),
+        target_is_like_darwin: sess.target.is_like_darwin,
+        target_is_like_aix: sess.target.is_like_aix,
+        target_is_like_gpu: sess.target.is_like_gpu,
+        split_debuginfo: sess.split_debuginfo(),
+        split_dwarf_kind: sess.opts.unstable_opts.split_dwarf_kind,
+        pointer_size: Size::from_bits(sess.target.pointer_width),
+        remark: sess.opts.cg.remark.clone(),
+        remark_dir: sess.opts.unstable_opts.remark_dir.clone(),
+        incr_comp_session_dir: None,
+        // Parallelism matters a lot for ThinLTO, which optimizes+codegens many modules.
+        parallel: backend.supports_parallel() && !sess.opts.unstable_opts.no_parallel_backend,
+        offload_emit: None,
+    }
+}
+
+/// Parse a CGU's emitted bitcode back into a module and run the pre-LTO optimization on it,
+/// i.e. everything `execute_optimize_work_item` does before it branches on the LTO type.
+fn parse_and_optimize(
+    sess: &Session,
+    cgcx: &CodegenContext,
+    tm_factory: &TargetMachineFactoryFn<LlvmCodegenBackend>,
+    cgu: &CompiledModule,
+    config: &ModuleConfig,
+    shared_emitter: &SharedEmitter,
+) -> ModuleCodegen<ModuleLlvm> {
+    let dcx = rustc_errors::DiagCtxt::new(Box::new(shared_emitter.clone()));
+    let dcx = dcx.handle();
+
+    let path = cgu
+        .bytecode
+        .as_deref()
+        .unwrap_or_else(|| dcx.fatal(format!("offload CGU `{}` has no bitcode", cgu.name)));
+    let bitcode = std::fs::read(path).unwrap_or_else(|err| {
+        dcx.fatal(format!("failed to read offload bitcode `{}`: {err}", path.display()))
+    });
+
+    let name = CString::new(cgu.name.clone()).unwrap();
+    let module_llvm = ModuleLlvm::parse(cgcx, Arc::clone(tm_factory), &name, &bitcode, dcx);
+    let mut module = ModuleCodegen {
+        name: cgu.name.clone(),
+        module_llvm,
+        kind: cgu.kind,
+        thin_lto_buffer: None,
+    };
+
+    back::write::optimize(cgcx, &sess.prof, shared_emitter, &mut module, config);
+    module
+}
+
+/// Resume a ThinLTO compilation: pre-link-optimize each local CGU, then hand them all to
+/// `do_thin_lto`, which does the thin-link against the upstream rlibs' bitcode and the
+/// per-module import + optimize + codegen. All of that — the heavy part of ThinLTO — runs
+/// here; only the final link stays on the host.
+fn thin_lto_codegen(
+    sess: &Session,
+    cgcx: &CodegenContext,
+    tm_factory: &TargetMachineFactoryFn<LlvmCodegenBackend>,
+    dir: &Path,
+    cgus: &[CompiledModule],
+    crate_info: &CrateInfo,
+    allocator_config: &ModuleConfig,
+    shared_emitter: SharedEmitter,
+) -> Vec<CompiledModule> {
+    // The exported-symbol set is derived from the frontend, so the emit step serialized it.
+    let sym_path = dir.join("lto-symbols");
+    let exported: Vec<String> = std::fs::read_to_string(&sym_path)
+        .unwrap_or_else(|err| {
+            sess.dcx().fatal(format!("failed to read `{}`: {err}", sym_path.display()))
+        })
+        .lines()
+        .filter(|l| !l.is_empty())
+        .map(str::to_string)
+        .collect();
+
+    // The upstream rlibs whose bitcode participates in LTO — recomputed from the crate info
+    // (no `TyCtxt` needed), exactly as `start_executing_work` does.
+    let mut rlib_files = Vec::new();
+    let _ = link::each_linked_rlib(crate_info, None, &mut |cnum, path| {
+        if !link::ignored_for_lto(sess, crate_info, cnum) {
+            rlib_files.push(path.to_path_buf());
+        }
+    });
+
+    let needs_thin = cgus
+        .iter()
+        .map(|cgu| {
+            let config = config_for(cgcx, allocator_config, cgu.kind);
+            let module = parse_and_optimize(sess, cgcx, tm_factory, cgu, config, &shared_emitter);
+            ThinLtoInput::Red {
+                name: module.name,
+                buffer: SerializedModule::Local(ModuleBuffer::new(
+                    module.module_llvm.llmod(),
+                    true,
+                )),
+            }
+        })
+        .collect();
+
+    do_thin_lto::<LlvmCodegenBackend>(
+        cgcx,
+        &sess.prof,
+        shared_emitter,
+        Arc::clone(tm_factory),
+        Arc::new(exported),
+        rlib_files,
+        needs_thin,
+    )
+}
+
+fn config_for<'a>(
+    cgcx: &'a CodegenContext,
+    allocator_config: &'a ModuleConfig,
+    kind: ModuleKind,
+) -> &'a ModuleConfig {
+    match kind {
+        ModuleKind::Regular => &cgcx.module_config,
+        ModuleKind::Allocator => allocator_config,
+    }
+}
+
+fn read_rlink(
+    sess: &Session,
+    path: &Path,
+) -> (CompiledModules, CrateInfo, rustc_metadata::EncodedMetadata, OutputFilenames) {
+    let data = std::fs::read(path).unwrap_or_else(|err| {
+        sess.dcx().fatal(format!("failed to read `{}`: {err}", path.display()))
+    });
+    CompiledModules::deserialize_rlink(sess, data).unwrap_or_else(|err| {
+        let reason = match err {
+            CodegenError::WrongFileType => "not an rlink file".to_string(),
+            CodegenError::EmptyVersionNumber => "empty version number".to_string(),
+            CodegenError::EncodingVersionMismatch { version_array, rlink_version } => {
+                format!("rlink format version mismatch: {rlink_version} vs {version_array}")
+            }
+            CodegenError::RustcVersionMismatch { rustc_version } => format!(
+                "rustc version mismatch: emit step used {rustc_version}, this is {}",
+                sess.cfg_version
+            ),
+            CodegenError::CorruptFile => "corrupt file".to_string(),
+        };
+        sess.dcx().fatal(format!("failed to read `{}`: {reason}", path.display()))
+    })
+}
+
+pub(crate) fn run(backend: &LlvmCodegenBackend, sess: &Session, dir: &Path) {
+    let (mut compiled_modules, crate_info, metadata, outputs) =
+        read_rlink(sess, &dir.join("offload.rlink"));
+    let outputs = Arc::new(outputs);
+
+    // The emit step's modules carry bitcode, not machine code. Take them out; what we
+    // produce below replaces them.
+    let cgus: Vec<CompiledModule> = compiled_modules
+        .modules
+        .drain(..)
+        .chain(compiled_modules.allocator_module.take())
+        .collect();
+
+    let (shared_emitter, shared_emitter_main) = SharedEmitter::new();
+    let cgcx = build_codegen_context(backend, sess, Arc::clone(&outputs));
+    let tm_factory = backend.target_machine_factory(sess, cgcx.opt_level, &cgcx.backend_features);
+    let allocator_config = ModuleConfig::new(ModuleKind::Allocator, sess, &cgcx.crate_types, false);
+
+    // Loop-invariant: it depends only on session-wide settings.
+    match compute_per_cgu_lto_type(&cgcx.lto, cgcx.use_linker_plugin_lto, &cgcx.crate_types) {
+        ComputedLtoType::No => {
+            for cgu in &cgus {
+                let config = config_for(&cgcx, &allocator_config, cgu.kind);
+                let module =
+                    parse_and_optimize(sess, &cgcx, &tm_factory, cgu, config, &shared_emitter);
+                let compiled =
+                    back::write::codegen(&cgcx, &sess.prof, &shared_emitter, module, config);
+                match cgu.kind {
+                    ModuleKind::Regular => compiled_modules.modules.push(compiled),
+                    ModuleKind::Allocator => compiled_modules.allocator_module = Some(compiled),
+                }
+            }
+        }
+        // ThinLTO folds every module (incl. the allocator) into `modules`.
+        ComputedLtoType::Thin => {
+            compiled_modules.modules = thin_lto_codegen(
+                sess,
+                &cgcx,
+                &tm_factory,
+                dir,
+                &cgus,
+                &crate_info,
+                &allocator_config,
+                shared_emitter.clone(),
+            );
+        }
+        ComputedLtoType::Fat => {
+            sess.dcx().fatal("backend offload of fat LTO (`-Clto=fat`) is not supported")
+        }
+    }
+
+    // Surface any diagnostics the LLVM backend emitted, then bail if any were errors.
+    shared_emitter_main.check(sess, false);
+    sess.dcx().abort_if_errors();
+
+    // Deterministic module order, matching the normal coordinator.
+    compiled_modules.modules.sort_by(|a, b| a.name.cmp(&b.name));
+
+    // distcc-style split: with `-Zno-link`, stop after producing the object files and
+    // serialize the now-complete results to an `.rlink`. The (cheap) final link is then
+    // done back on the host with `rustc -Zlink-only`, using its native linker, sysroot and
+    // dependency libraries. The fixed name lets the host-side wrapper find it without
+    // reconstructing the output filestem.
+    if sess.opts.unstable_opts.no_link {
+        let rlink_file = dir.join("codegen.rlink");
+        CompiledModules::serialize_rlink(
+            sess,
+            &rlink_file,
+            &compiled_modules,
+            &crate_info,
+            &metadata,
+            &outputs,
+        )
+        .unwrap_or_else(|err| {
+            sess.dcx().fatal(format!("failed to write `{}`: {err}", rlink_file.display()))
+        });
+    } else {
+        backend.link(sess, compiled_modules, crate_info, metadata, &outputs);
+    }
+}

+//! Backend offload, resume side (Option B).
+//!
+//! Implements `-Zoffload-codegen=<dir>`: pick up the unoptimized bitcode and serialized
+//! crate info that an earlier `-Zoffload-emit` run left in `<dir>`, run the LLVM
+//! optimization + machine-code pipeline on each codegen unit, and link — all without
+//! running the frontend.
+//!
+//! This is invoked with the *same* target and codegen flags as the emit step, so the
+//! `Session` already carries everything needed to rebuild an equivalent `CodegenContext`
+//! and `ModuleConfig`. The only things that cannot be recomputed without the frontend —
+//! the crate info, encoded metadata and output filenames — are read back from the
+//! `offload.rlink` file (the same serialization used by `-Zno-link`).
+
+use std::ffi::CString;
+use std::path::Path;
+use std::sync::Arc;
+
+use rustc_abi::Size;
+use rustc_codegen_ssa::back::link;
+use rustc_codegen_ssa::back::lto::SerializedModule;
+use rustc_codegen_ssa::back::write::{
+    CodegenContext, ComputedLtoType, ModuleConfig, SharedEmitter, ThinLtoInput,
+    compute_per_cgu_lto_type, do_thin_lto,
+};
+use rustc_codegen_ssa::traits::{ExtraBackendMethods, WriteBackendMethods};
+use rustc_codegen_ssa::{
+    CodegenError, CompiledModule, CompiledModules, CrateInfo, ModuleCodegen, ModuleKind,
+};
+use rustc_session::Session;
+use rustc_session::config::Lto;
+
+use crate::back::lto::ModuleBuffer;
+use crate::{LlvmCodegenBackend, ModuleLlvm, back, llvm_util};
+
+/// A codegen unit to resume, as listed in `offload.cgus`.
+struct OffloadCgu {
+    name: String,
+    kind: ModuleKind,
+    bitcode: std::path::PathBuf,
+}
+
+fn read_cgu_list(sess: &Session, dir: &Path) -> Vec<OffloadCgu> {
+    let path = dir.join("offload.cgus");
+    let contents = std::fs::read_to_string(&path).unwrap_or_else(|err| {
+        sess.dcx().fatal(format!("failed to read offload CGU list `{}`: {err}", path.display()))
+    });
+    contents
+        .lines()
+        .filter(|l| !l.trim().is_empty())
+        .map(|line| {
+            let mut fields = line.split('\t');
+            let kind = match fields.next() {
+                Some("regular") => ModuleKind::Regular,
+                Some("allocator") => ModuleKind::Allocator,
+                other => sess.dcx().fatal(format!("invalid CGU kind in offload list: {other:?}")),
+            };
+            let name = fields
+                .next()
+                .unwrap_or_else(|| sess.dcx().fatal("malformed offload CGU list entry"))
+                .to_string();
+            let bitcode = fields
+                .next()
+                .unwrap_or_else(|| sess.dcx().fatal("malformed offload CGU list entry"))
+                .into();
+            OffloadCgu { name, kind, bitcode }
+        })
+        .collect()
+}
+
+/// Build a `CodegenContext` equivalent to the one the normal pipeline would build, but
+/// from the `Session` alone (no `TyCtxt`). See the module docs for why this is sound.
+//
+// `bad_opt_access`: the lint steers towards `TyCtxt::crate_types`, but the whole point of
+// this path is that there is no `TyCtxt`; the command line's `--crate-type` (mirrored from
+// the emit step) is the source of truth here.
+#[allow(rustc::bad_opt_access)]
+fn build_codegen_context(
+    backend: &LlvmCodegenBackend,
+    sess: &Session,
+    outputs: Arc<rustc_session::config::OutputFilenames>,
+) -> CodegenContext {
+    let crate_types = sess.opts.crate_types.clone();
+
+    let module_config =
+        Arc::new(ModuleConfig::new_offload(ModuleKind::Regular, sess, &crate_types, false));
+
+    // `-Zoffload-codegen` only targets the common (non-size) optimization levels for now;
+    // `backend_optimization_level` reduces to `sess.opts.optimize` there (the size levels
+    // additionally consult per-item `#[optimize]` attrs, which need the frontend).
+    let opt_level = sess.opts.optimize;
+    let target_features = llvm_util::global_llvm_features(sess, false);
+
+    let msvc_imps_needed = sess.target.is_like_windows
+        && (sess.lto() == Lto::Thin
+            || crate_types.contains(&rustc_session::config::CrateType::Rlib));
+
+    CodegenContext {
+        lto: sess.lto(),
+        use_linker_plugin_lto: sess.opts.cg.linker_plugin_lto.enabled(),
+        dylib_lto: sess.opts.unstable_opts.dylib_lto,
+        prefer_dynamic: sess.opts.cg.prefer_dynamic,
+        save_temps: sess.opts.cg.save_temps,
+        fewer_names: sess.fewer_names(),
+        time_trace: sess.opts.unstable_opts.llvm_time_trace,
+        crate_types,
+        output_filenames: outputs,
+        invocation_temp: sess.invocation_temp.clone(),
+        module_config,
+        opt_level,
+        backend_features: target_features,
+        msvc_imps_needed,
+        is_pe_coff: sess.target.is_like_windows,
+        target_can_use_split_dwarf: sess.target_can_use_split_dwarf(),
+        target_arch: sess.target.arch.to_string(),
+        target_is_like_darwin: sess.target.is_like_darwin,
+        target_is_like_aix: sess.target.is_like_aix,
+        target_is_like_gpu: sess.target.is_like_gpu,
+        split_debuginfo: sess.split_debuginfo(),
+        split_dwarf_kind: sess.opts.unstable_opts.split_dwarf_kind,
+        pointer_size: Size::from_bits(sess.target.pointer_width),
+        remark: sess.opts.cg.remark.clone(),
+        remark_dir: sess.opts.unstable_opts.remark_dir.clone(),
+        incr_comp_session_dir: None,
+        // Parallelize the backend: matters a lot for ThinLTO, which optimizes+codegens many
+        // modules per crate (the final whole-program crate especially). Mirrors the normal
+        // pipeline's choice.
+        parallel: backend.supports_parallel() && !sess.opts.unstable_opts.no_parallel_backend,
+        offload_emit: None,
+    }
+}
+
+/// Resume one codegen unit: parse its unoptimized bitcode back into a module, then run the
+/// same optimize + codegen steps the normal pipeline runs.
+fn codegen_one_cgu(
+    backend: &LlvmCodegenBackend,
+    sess: &Session,
+    cgcx: &CodegenContext,
+    cgu: &OffloadCgu,
+    allocator_config: &ModuleConfig,
+    shared_emitter: SharedEmitter,
+) -> CompiledModule {
+    let dcx = rustc_errors::DiagCtxt::new(Box::new(shared_emitter.clone()));
+    let dcx = dcx.handle();
+
+    let bitcode = std::fs::read(&cgu.bitcode).unwrap_or_else(|err| {
+        dcx.fatal(format!("failed to read offload bitcode `{}`: {err}", cgu.bitcode.display()))
+    });
+
+    let name = CString::new(cgu.name.clone()).unwrap();
+    let tm_factory = backend.target_machine_factory(sess, cgcx.opt_level, &cgcx.backend_features);
+    let module_llvm = ModuleLlvm::parse(cgcx, tm_factory, &name, &bitcode, dcx);
+    let mut module =
+        ModuleCodegen { name: cgu.name.clone(), module_llvm, kind: cgu.kind, thin_lto_buffer: None };
+
+    let config = match cgu.kind {
+        ModuleKind::Regular => &cgcx.module_config,
+        ModuleKind::Allocator => allocator_config,
+    };
+
+    back::write::optimize(cgcx, &sess.prof, &shared_emitter, &mut module, config);
+    back::write::codegen(cgcx, &sess.prof, &shared_emitter, module, config)
+}
+
+/// Resume a ThinLTO compilation (`-Clto=thin`). For each local CGU we parse the bitcode
+/// and run the per-module pre-link optimization, then hand all the modules to the existing
+/// `do_thin_lto`, which does the thin-link (combining with the upstream rlibs' bitcode) and
+/// the per-module import + optimize + codegen. All of this — the heavy part of ThinLTO —
+/// runs here on the build machine; only the final link stays on the host.
+fn thin_lto_codegen(
+    backend: &LlvmCodegenBackend,
+    cgcx: &CodegenContext,
+    sess: &Session,
+    dir: &Path,
+    cgus: &[OffloadCgu],
+    crate_info: &CrateInfo,
+    allocator_config: &ModuleConfig,
+    shared_emitter: SharedEmitter,
+) -> Vec<CompiledModule> {
+    // The exported-symbol set is derived from the frontend, so the emit step serialized it.
+    let sym_path = dir.join("lto-symbols");
+    let exported: Vec<String> = std::fs::read_to_string(&sym_path)
+        .unwrap_or_else(|err| {
+            sess.dcx().fatal(format!("failed to read `{}`: {err}", sym_path.display()))
+        })
+        .lines()
+        .filter(|l| !l.is_empty())
+        .map(str::to_string)
+        .collect();
+
+    // The upstream rlibs whose bitcode participates in LTO — recomputed from the crate info
+    // (no `TyCtxt` needed), exactly as `start_executing_work` does.
+    let mut rlib_files = Vec::new();
+    let _ = link::each_linked_rlib(crate_info, None, &mut |cnum, path| {
+        if !link::ignored_for_lto(sess, crate_info, cnum) {
+            rlib_files.push(path.to_path_buf());
+        }
+    });
+
+    // Parse + pre-link-optimize each local CGU and route it like the normal coordinator.
+    let mut needs_thin: Vec<ThinLtoInput<LlvmCodegenBackend>> = Vec::new();
+    let mut compiled: Vec<CompiledModule> = Vec::new();
+    for cgu in cgus {
+        let dcx = rustc_errors::DiagCtxt::new(Box::new(shared_emitter.clone()));
+        let dcx = dcx.handle();
+
+        let bitcode = std::fs::read(&cgu.bitcode).unwrap_or_else(|err| {
+            dcx.fatal(format!("failed to read offload bitcode `{}`: {err}", cgu.bitcode.display()))
+        });
+        let name = CString::new(cgu.name.clone()).unwrap();
+        let tm_factory = backend.target_machine_factory(sess, cgcx.opt_level, &cgcx.backend_features);
+        let module_llvm = ModuleLlvm::parse(cgcx, tm_factory, &name, &bitcode, dcx);
+        let mut module = ModuleCodegen {
+            name: cgu.name.clone(),
+            module_llvm,
+            kind: cgu.kind,
+            thin_lto_buffer: None,
+        };
+        let config = match cgu.kind {
+            ModuleKind::Regular => &cgcx.module_config,
+            ModuleKind::Allocator => allocator_config,
+        };
+
+        back::write::optimize(cgcx, &sess.prof, &shared_emitter, &mut module, config);
+        match compute_per_cgu_lto_type(&cgcx.lto, cgcx.use_linker_plugin_lto, &cgcx.crate_types) {
+            ComputedLtoType::Thin => needs_thin.push(ThinLtoInput::Red {
+                name: module.name.clone(),
+                buffer: SerializedModule::Local(ModuleBuffer::new(module.module_llvm.llmod(), true)),
+            }),
+            ComputedLtoType::No => compiled.push(back::write::codegen(cgcx, &sess.prof, &shared_emitter, module, config)),
+            ComputedLtoType::Fat => {
+                dcx.fatal("backend offload of fat LTO (`-Clto=fat`) is not supported")
+            }
+        }
+    }
+
+    let tm_factory = backend.target_machine_factory(sess, cgcx.opt_level, &cgcx.backend_features);
+    // Thin-link + per-module import/optimize/codegen (the offloaded heavy lifting).
+    compiled.extend(do_thin_lto::<LlvmCodegenBackend>(cgcx, &sess.prof, shared_emitter, tm_factory, Arc::new(exported), rlib_files, needs_thin));
+    compiled
+}
+
+pub(crate) fn run(backend: &LlvmCodegenBackend, sess: &Session, dir: &Path) {
+    // Read back everything the frontend produced.
+    let cgus = read_cgu_list(sess, dir);
+
+    let rlink_path = dir.join("offload.rlink");
+    let rlink_data = std::fs::read(&rlink_path).unwrap_or_else(|err| {
+        sess.dcx().fatal(format!("failed to read `{}`: {err}", rlink_path.display()))
+    });
+    let (mut compiled_modules, crate_info, metadata, outputs) =
+        match CompiledModules::deserialize_rlink(sess, rlink_data) {
+            Ok(tuple) => tuple,
+            Err(err) => {
+                let reason = match err {
+                    CodegenError::WrongFileType => "not an offload rlink file".to_string(),
+                    CodegenError::EmptyVersionNumber => "empty version number".to_string(),
+                    CodegenError::EncodingVersionMismatch { version_array, rlink_version } => {
+                        format!("rlink format version mismatch: {rlink_version} vs {version_array}")
+                    }
+                    CodegenError::RustcVersionMismatch { rustc_version } => format!(
+                        "rustc version mismatch: emit step used {rustc_version}, this is {}",
+                        sess.cfg_version
+                    ),
+                    CodegenError::CorruptFile => "corrupt file".to_string(),
+                };
+                sess.dcx().fatal(format!("failed to read `{}`: {reason}", rlink_path.display()))
+            }
+        };
+    let outputs = Arc::new(outputs);
+
+    let (shared_emitter, shared_emitter_main) = SharedEmitter::new();
+    let cgcx = build_codegen_context(backend, sess, Arc::clone(&outputs));
+
+    let allocator_config =
+        Arc::new(ModuleConfig::new_offload(ModuleKind::Allocator, sess, &cgcx.crate_types, false));
+
+    if sess.lto() == Lto::Thin {
+        // ThinLTO: the expensive cross-module optimization, offloaded here. `compiled_modules`
+        // carries empty modules from the emit step; fill them with the LTO output. ThinLTO
+        // folds every module (incl. the allocator) into `modules`.
+        compiled_modules.modules = thin_lto_codegen(backend, &cgcx, sess, dir, &cgus, &crate_info, &allocator_config, shared_emitter.clone());
+    } else {
+        // Optimize + codegen each CGU. Runs synchronously; parallelism is a later refinement.
+        for cgu in &cgus {
+            let compiled = codegen_one_cgu(backend, sess, &cgcx, cgu, &allocator_config, shared_emitter.clone());
+            match cgu.kind {
+                ModuleKind::Regular => compiled_modules.modules.push(compiled),
+                ModuleKind::Allocator => compiled_modules.allocator_module = Some(compiled),
+            }
+        }
+    }
+
+    // Surface any diagnostics the LLVM backend emitted, then bail if any were errors.
+    shared_emitter_main.check(sess, false);
+    sess.dcx().abort_if_errors();
+
+    // Deterministic module order, matching the normal coordinator.
+    compiled_modules.modules.sort_by(|a, b| a.name.cmp(&b.name));
+
+    // distcc-style split: with `-Zno-link`, stop after producing the object files and
+    // serialize the now-complete `CodegenResults` to an `.rlink`. The (cheap, fully
+    // transparent) final link is then done back on the host with `rustc -Zlink-only`,
+    // using its native linker, sysroot and dependency libraries. Without `-Zno-link` we
+    // link here, reusing the crate info / metadata / outputs from the emit step.
+    if sess.opts.unstable_opts.no_link {
+        // Write the rlink to a fixed name inside the offload dir (rather than the usual
+        // `<out>.rlink`) so the host-side wrapper can find it deterministically for the
+        // `-Zlink-only` step without having to reconstruct the output filestem.
+        let rlink_file = dir.join("codegen.rlink");
+        CompiledModules::serialize_rlink(
+            sess,
+            &rlink_file,
+            &compiled_modules,
+            &crate_info,
+            &metadata,
+            &outputs,
+        )
+        .unwrap_or_else(|err| {
+            sess.dcx().fatal(format!("failed to write `{}`: {err}", rlink_file.display()))
+        });
+    } else {
+        use rustc_codegen_ssa::traits::CodegenBackend;
+        backend.link(sess, compiled_modules, crate_info, metadata, &outputs);
+    }
+}

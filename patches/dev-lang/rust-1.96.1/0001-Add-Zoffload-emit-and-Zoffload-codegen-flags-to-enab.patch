+/// `-Zoffload-emit`: write a fully codegened but still unoptimized module out as bitcode
+/// instead of optimizing it. That state serializes cleanly, so `-Zoffload-codegen` can pick
+/// it up on another machine and run the optimization/codegen pipeline there.
+///
+/// The result is a `CompiledModule` whose only artifact is the bitcode, so it travels to
+/// the resume step through the usual `.rlink` serialization.
+fn offload_emit_module<B: WriteBackendMethods>(
+    dir: &Path,
+    module: ModuleCodegen<B::Module>,
+    shared_emitter: &SharedEmitter,
+) -> CompiledModule {
+    let bytecode = dir.join(format!("{}.bc", module.name));
+    let buffer = B::serialize_module(module.module_llvm, false);
+    if let Err(err) = fs::write(&bytecode, buffer.data()) {
+        shared_emitter.fatal(&format!("failed to write `{}`: {err}", bytecode.display()));
+    }
+    CompiledModule {
+        name: module.name,
+        kind: module.kind,
+        object: None,
+        dwarf_object: None,
+        bytecode: Some(bytecode),
+        assembly: None,
+        llvm_ir: None,
+        links_from_incr_cache: vec![],
+    }
+}
